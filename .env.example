# Banco de dados
DATABASE_NAME=spectrum
DATABASE_USER=spectrum
DATABASE_PASSWORD=spectrum

# Aplicação
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# JWT — gere um segredo forte em produção (base64, mínimo 256 bits)
JWT_SECRET=change-me-please-use-a-strong-random-base64-secret-with-at-least-256-bits
JWT_EXPIRATION_MS=3600000
JWT_REFRESH_EXPIRATION_MS=604800000

# Gemini AI — obtenha em https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ===== FIPE API =====
# Usado exclusivamente para popular o catálogo de veículos (vehicles_catalog).
# 1. Crie uma conta gratuita em https://fipe.online
# 2. Copie o token em https://fipe.online/dashboard
# 3. Cole aqui — cada desenvolvedor usa o seu próprio token
FIPE_API_TOKEN=seu-token-aqui

# URL base da API (não alterar em dev/prod)
FIPE_API_BASE_URL=https://fipe.parallelum.com.br/api/v2

# Tipo de veículo a importar: cars | motorcycles | trucks (padrão: cars)
FIPE_VEHICLE_TYPE=cars

# Filtra o import para apenas Picapes e SUVs (true) ou importa todos os modelos (false)
FIPE_FILTER_SEGMENTS=true

# Ano mínimo de produção: descarta modelos cujo último ano disponível seja anterior a este valor
FIPE_MIN_YEAR=2022

# ===== Exportacao de dados (CSV / PDF) =====
# Bucket do GCS onde os arquivos exportados ficam armazenados.
GCS_EXPORT_BUCKET=
GCP_PROJECT_ID=

# Caminho para o JSON da service account com roles/storage.objectAdmin no bucket.
# A assinatura de URL V4 exige uma chave privada, entao use uma service account
# COM chave JSON (nao apenas credencial do metadata server).
GOOGLE_APPLICATION_CREDENTIALS=/caminho/para/service-account.json

# Alternativa para plataformas sem arquivo de secret (Railway, Heroku, Fly):
# conteudo do JSON da service account, em texto puro ou base64. Tem precedencia
# sobre GOOGLE_APPLICATION_CREDENTIALS. Em dev normalmente fica vazio.
#GCP_CREDENTIALS_JSON=

# Validade da URL de download, em minutos (padrao: 60)
EXPORT_URL_TTL_MINUTES=60

# Caminho do JSON da service account no host. Usado apenas pelo
# docker-compose.override.yml (veja docker-compose.override.yml.example).
GCP_CREDENTIALS_FILE=./gcp-credentials.json

# ===== CORS =====
# Origens permitidas, separadas por virgula. Deixe COMENTADO para usar os padroes
# de desenvolvimento (localhost em qualquer porta + faixas de rede local, para o
# app no celular). Se descomentar, NAO deixe vazio: uma lista vazia bloqueia todas
# as requisicoes com 403 "Invalid CORS request".
# Em producao, liste os dominios exatos do frontend, sem curinga.
#CORS_ALLOWED_ORIGINS=https://app.seudominio.com
